{
  "name": "mcp-server-dataset",
  "version": "1.0.1",
  "description": "MCP server for the Scalyr/DataSet log management API",
  "type": "module",
  "bin": {
    "mcp-server-dataset": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest --exclude tests/integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scalyr",
    "dataset",
    "logs",
    "observability"
  ],
  "license": "MIT",
  "author": "AdKnown Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celos101/mcp-server-dataset.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
